import math

def calculate_decay_time(initial_dB, final_dB, RT60):
    """
    Bereken de tijd voor de geluidsafname van een bepaald aantal dB.
    initial_dB: De initiële geluidssterkte in dB.
    final_dB: De dB-afname die we willen bereiken (bijv. 20 dB).
    RT60: De nagalmtijd (in seconden).
    
    Retourneer de tijd in seconden.
    """
    # Gebruik de afnameformule: L(t) = L_0 - 10 * log10(t / T)
    # Herbereken de tijd t waarvoor de afname 20 dB is.
    time_to_decay = RT60 * 10**((initial_dB - final_dB) / 20)
    return time_to_decay

# Instellingen
initial_dB = maxDB  # Begin dB (bijv. de maximale geluidssterkte)
final_dB = 20   # De dB-afname die we willen bereiken
RT60 = 0.00001        # De nagalmtijd in seconden (bijvoorbeeld 2 seconden)

# Bereken de tijd voor de 20 dB afname
time_for_20dB_decay = calculate_decay_time(initial_dB, final_dB, RT60)

# Vermenigvuldig de tijd met 3, zoals gevraagd
time_x3 = time_for_20dB_decay * 3

# Toon het resultaat
print(f"De tijd voor een afname van {final_dB} dB is {time_for_20dB_decay:.2f} seconden.")
print(f"De tijd vermenigvuldigd met 3 is: {time_x3:.2f} seconden.")






